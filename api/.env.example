# Copy this file to api/.env and fill it in. Never commit api/.env.

# Required: any PostgreSQL 16 database (a free Neon project, or the Docker one from the README)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/festpass

# Required: two long random strings (any text works locally)
JWT_SECRET=change-me-to-a-long-random-string
QR_SECRET=change-me-to-another-long-random-string

# Email: any value lets the API start. A real Resend key sends ticket emails.
RESEND_API_KEY=re_placeholder
# Resend's free tier only delivers to your own address, so send every ticket there
# TICKET_EMAIL_TO=you@example.com

# Rate limiting: off locally. To turn it on, delete this line and add a free Upstash Redis database
RATE_LIMIT=off
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Web app URL allowed by CORS
WEB_ORIGIN=http://localhost:3000